/* Nunito font family for body text */
@font-face {
  font-family: 'Nunito';
  src: url('{{ "Nunito-Regular.woff2" | asset_url }}') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Nunito';
  src: url('{{ "Nunito-SemiBold.woff2" | asset_url }}') format('woff2');
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Nunito';
  src: url('{{ "Nunito-Bold.woff2" | asset_url }}') format('woff2');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
