{{ 'section-stockist-row.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign brands_row_1 = section.settings.brands_row_1 | split: ','
  assign brands_row_2 = section.settings.brands_row_2 | split: ','

  case section.settings.separator
    when 'diamond'
      assign separator = '◇'
    else
      assign separator = '·'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --stockist-duration: {{ section.settings.speed_seconds }}s;
    --stockist-fade: {{ section.settings.edge_fade_px }}px;
    --stockist-row-gap: {{ section.settings.row_gap_em }}em;
    --stockist-item-gap: {{ section.settings.item_gap_em }}em;
    --stockist-letter-spacing: {{ section.settings.letter_spacing_thousandths | divided_by: 1000.0 }}em;
  }

  #shopify-section-{{ section.id }} .stockist-rows {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} .stockist-track {
    font-size: {{ section.settings.font_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .stockist-rows {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #shopify-section-{{ section.id }} .stockist-track {
      font-size: {{ section.settings.font_size_tablet }}px;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .stockist-track {
      font-size: {{ section.settings.font_size_desktop }}px;
    }
  }
{%- endstyle -%}

<section
  class="stockist-section color-{{ section.settings.color_scheme }} gradient"
  aria-labelledby="stockist-heading-{{ section.id }}"
>
  <h2 id="stockist-heading-{{ section.id }}" class="stockist-visually-hidden">
    {{ section.settings.accessible_heading | default: 'Our stockists' }}
  </h2>

  <div class="stockist-rows">
    {%- for row_index in (1..2) -%}
      {%- if row_index == 1 -%}
        {%- assign brands = brands_row_1 -%}
        {%- assign direction = 'ltr' -%}
      {%- else -%}
        {%- assign brands = brands_row_2 -%}
        {%- assign direction = 'rtl' -%}
      {%- endif -%}

      {%- assign brand_count = 0 -%}
      {%- for brand in brands -%}
        {%- assign clean_brand = brand | strip -%}
        {%- if clean_brand != blank -%}
          {%- assign brand_count = brand_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if brand_count > 0 -%}
        <div class="stockist-row" data-direction="{{ direction }}">
          <ul class="stockist-track">
            {%- for brand in brands -%}
              {%- assign clean_brand = brand | strip -%}
              {%- if clean_brand != blank -%}
                <li class="stockist-track__item">{{ clean_brand }}</li>
                <li class="stockist-track__sep" aria-hidden="true">{{ separator }}</li>
              {%- endif -%}
            {%- endfor -%}
            {%- for brand in brands -%}
              {%- assign clean_brand = brand | strip -%}
              {%- if clean_brand != blank -%}
                <li class="stockist-track__item" aria-hidden="true" data-clone="true">{{ clean_brand }}</li>
                <li class="stockist-track__sep" aria-hidden="true" data-clone="true">{{ separator }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Stockist row",
  "tag": "section",
  "class": "section section-stockist-row",
  "settings": [
    {
      "type": "header",
      "content": "Brands"
    },
    {
      "type": "textarea",
      "id": "brands_row_1",
      "label": "Row 1 (scrolls left → right)",
      "info": "Comma-separated. Render names exactly as written, including capitalization and accents.",
      "default": "Petit Bateau, Konges Sløjd, Arsène et les Pipelettes, VEJA, Mini Rodini, Maison Mangostan, Liewood, Halcyon Nights, Moulin Roty, Wooly Organic"
    },
    {
      "type": "textarea",
      "id": "brands_row_2",
      "label": "Row 2 (scrolls right → left)",
      "info": "Comma-separated.",
      "default": "SCOTCH & SODA, Londji, American Vintage, Goldie and Ace, Le Toy Van, Favorite People, Flöss Aps, MP, Rockahulla, GOMMU"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "speed_seconds",
      "label": "Cycle duration",
      "info": "Higher = slower. Default 75s for an ambient feel.",
      "min": 30,
      "max": 180,
      "step": 5,
      "default": 75,
      "unit": "s"
    },
    {
      "type": "range",
      "id": "edge_fade_px",
      "label": "Edge fade width",
      "min": 40,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font size (desktop)",
      "min": 18,
      "max": 56,
      "step": 1,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size_tablet",
      "label": "Font size (tablet)",
      "min": 16,
      "max": 40,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size (mobile)",
      "min": 14,
      "max": 32,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "letter_spacing_thousandths",
      "label": "Letter spacing (× 0.001em)",
      "info": "10 = 0.010em (very slightly open). 0 = default tracking.",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 10,
      "unit": "‰"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separator glyph",
      "options": [
        { "value": "middot", "label": "Bullet (·)" },
        { "value": "diamond", "label": "Diamond (◇)" }
      ],
      "default": "middot"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "row_gap_em",
      "label": "Vertical gap between rows",
      "min": 0.5,
      "max": 4.0,
      "step": 0.1,
      "default": 1.5,
      "unit": "em"
    },
    {
      "type": "range",
      "id": "item_gap_em",
      "label": "Gap around separator",
      "min": 0.2,
      "max": 1.5,
      "step": 0.1,
      "default": 0.6,
      "unit": "em"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-brand-cream-light"
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "accessible_heading",
      "label": "Screen-reader heading (visually hidden)",
      "default": "Our stockists"
    }
  ],
  "presets": [
    {
      "name": "Stockist row"
    }
  ]
}
{% endschema %}
