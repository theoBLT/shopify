{%- comment -%}
  KT Instagram strip — repeating tile blocks with brand-color backgrounds.
  Each tile is editable (image, bg color, link, aria-label).
{%- endcomment -%}

{{ 'section-kt-ig-strip.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sec = section.settings
  assign cols_d = sec.tile_columns_desktop | default: 6
  assign cols_m = sec.tile_columns_mobile | default: 2
-%}

{%- style -%}
  #kt-ig-{{ section.id }} .kt-ig__grid {
    grid-template-columns: repeat({{ cols_m }}, minmax(0, 1fr));
  }
  @media (min-width: 750px) {
    #kt-ig-{{ section.id }} .kt-ig__grid {
      grid-template-columns: repeat({{ cols_d }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<section
  id="kt-ig-{{ section.id }}"
  class="kt-section-tight kt-ig color-{{ sec.color_scheme }} gradient"
  aria-labelledby="kt-ig-title-{{ section.id }}">
  <div class="kt-container">
    <div class="kt-ig__head">
      <div>
        {%- if sec.eyebrow != blank -%}
          <div class="kt-eyebrow-strong kt-ig__eyebrow">{{ sec.eyebrow }}</div>
        {%- endif -%}
        {%- if sec.title != blank -%}
          <h3 id="kt-ig-title-{{ section.id }}" class="kt-ig__title">{{ sec.title }}</h3>
        {%- endif -%}
      </div>
      {%- if sec.cta_label != blank and sec.cta_link != blank -%}
        <a class="kt-button kt-button--ghost kt-button--sm" href="{{ sec.cta_link }}"
           target="_blank" rel="noopener noreferrer">
          {{ sec.cta_label }} <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>

    {%- if sec.show_tile_grid and section.blocks.size > 0 -%}
      <div class="kt-ig__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tile' -%}
            {%- liquid
              assign bg = block.settings.bg_color | default: 'cream'
              assign tile_link = block.settings.link | default: sec.cta_link
              assign tile_aria = block.settings.aria_label | default: sec.title
            -%}
            <a class="kt-ig__tile kt-bg-{{ bg }} lift"
               href="{{ tile_link | default: '#' }}"
               target="_blank" rel="noopener noreferrer"
               aria-label="{{ tile_aria | escape }}"
               {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank or block.settings.inline_asset != blank -%}
                {% render 'kt-image',
                    image: block.settings.image,
                    inline_asset_fallback: block.settings.inline_asset,
                    class: '',
                    alt: tile_aria,
                    loading: 'lazy' %}
              {%- endif -%}
              <span class="kt-ig__icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="5"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
                </svg>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "KT Instagram strip",
  "tag": "section",
  "class": "section section-kt-ig-strip",
  "enabled_on": { "templates": ["index", "page"] },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "paragraph",
      "content": "To pull live Instagram posts: install Instafeed Lite from the Shopify App Store, add the Instafeed section in the editor and drag it directly below this section, then turn off \"Show placeholder tile grid\" below. Inside Instafeed's settings, also blank out its heading so the @kindertresor title doesn't render twice."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "On the gram"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "@kindertresor"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Follow along"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Tile grid (placeholders)"
    },
    {
      "type": "checkbox",
      "id": "show_tile_grid",
      "label": "Show placeholder tile grid",
      "info": "Turn off when an Instafeed section is rendering the real Instagram photos directly below this header.",
      "default": true
    },
    {
      "type": "range",
      "id": "tile_columns_desktop",
      "label": "Columns (desktop)",
      "min": 3, "max": 8, "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "tile_columns_mobile",
      "label": "Columns (mobile)",
      "min": 2, "max": 4, "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-brand-cream-light"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image",
          "info": "Upload a photo or leave blank to use a brand Kinbear shipped with the theme (set the asset filename below)."
        },
        {
          "type": "text",
          "id": "inline_asset",
          "label": "Default Kinbear asset (fallback)",
          "info": "Filename in theme/assets/ — used when no image is uploaded. e.g. kinbear-cream.svg",
          "default": "kinbear-cream.svg"
        },
        {
          "type": "select",
          "id": "bg_color",
          "label": "Background color",
          "options": [
            { "value": "pink",     "label": "Pink" },
            { "value": "cream",    "label": "Cream" },
            { "value": "cyan",     "label": "Cyan" },
            { "value": "yellow",   "label": "Yellow" },
            { "value": "coral",    "label": "Coral" },
            { "value": "green",    "label": "Green" },
            { "value": "cream-light", "label": "Cream light" },
            { "value": "charcoal", "label": "Charcoal" }
          ],
          "default": "cream"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Tile link",
          "info": "Defaults to the section CTA link."
        },
        {
          "type": "text",
          "id": "aria_label",
          "label": "Accessible label",
          "default": "Open Instagram"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram strip (Kinder Tresor)",
      "blocks": [
        { "type": "tile", "settings": { "bg_color": "pink",   "inline_asset": "kinbear-cream.svg" } },
        { "type": "tile", "settings": { "bg_color": "cream",  "inline_asset": "kinbear-cat01-fixed.svg" } },
        { "type": "tile", "settings": { "bg_color": "cyan",   "inline_asset": "kinbear-cat02-fixed.svg" } },
        { "type": "tile", "settings": { "bg_color": "yellow", "inline_asset": "kinbear-pink.svg" } },
        { "type": "tile", "settings": { "bg_color": "coral",  "inline_asset": "kinbear-cat03-fixed.svg" } },
        { "type": "tile", "settings": { "bg_color": "green",  "inline_asset": "kinbear-cat04-fixed.svg" } }
      ]
    }
  ]
}
{% endschema %}
